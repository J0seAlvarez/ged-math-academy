{
  "name": "ged-math-academy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "TUTOR_MODEL": "gpt-6-luna"
  },
  "d1_databases": [
    {
      "binding": "ged_math_academy_db",
      "database_name": "ged-math-academy-db",
      "database_id": "89f85322-36b0-4f5b-8c8d-0404f7cdad77",
      "migrations_dir": "migrations"
    }
  ]
}
